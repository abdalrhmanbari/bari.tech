# Public base URL used for canonical links, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://abd-alrhman-al-bari.vercel.app

# --- Contact form (Gmail SMTP via an App Password) ---
# 1. Enable 2-Step Verification on the Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Put the 16-character password below (spaces are fine, they're stripped).
GMAIL_USER=bariabdalrhman@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: where enquiries are delivered. Defaults to GMAIL_USER.
CONTACT_TO=bariabdalrhman@gmail.com

# Optional: override the form's POST target (e.g. a Formspree URL).
# Leave empty to use the built-in /api/contact route above.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# --- Content dashboard (/admin) ---
# Password required to sign in to /admin and edit site content.
# Content is stored in Netlify Blobs, so the dashboard only works once the
# site is deployed on Netlify (or run locally via `netlify dev`).
ADMIN_PASSWORD=
